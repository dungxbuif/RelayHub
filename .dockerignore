# Default-deny Docker context. Dockerfile copies only these build inputs.
*

!Dockerfile
!.dockerignore
!compose.yaml
!.env.example

!backend/
!backend/**
!sdks/
!sdks/**
!backend/go.mod
!backend/go.sum
!backend/cmd/
!backend/cmd/**
!backend/internal/
!backend/internal/**
!backend/web/
!backend/web/**
!backend/scripts/
!backend/scripts/**
!web/
!web/admin/
!web/admin/**
!web/docs/
!web/docs/**
!web/docs/static/
!web/docs/static/**
!docs/
!docs/developer/
!docs/developer/streaming-protocol.md

# Never include local state or generated package installs.
.git
.git/**
.env
.env.*
!.env.example
**/node_modules/**
**/dist/**
e2e-artifacts/**
