{
  "type": "object",
  "properties": {
    "type": {
      "type": "string"
    },
    "topics": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "invocation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "ok": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "result": {},
    "error": {}
  },
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "ping"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "subscribe"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "events",
              "jobs",
              "functions"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "topics"
      ]
    },
    {
      "properties": {
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ok": {
          "type": "boolean"
        },
        "result": {},
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "description": "Message limit is 1024 UTF-8 bytes; JSON Schema maxLength is a character bound. The runtime enforces the byte bound."
        },
        "type": {
          "const": "rpc.result"
        }
      },
      "required": [
        "invocation_id",
        "ok"
      ],
      "oneOf": [
        {
          "properties": {
            "ok": {
              "const": true
            }
          },
          "required": [
            "result"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "properties": {
            "ok": {
              "const": false
            }
          },
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "result"
            ]
          }
        }
      ]
    }
  ],
  "description": "Accepted JSON text frames. Complete encoded messages must fit 64 KiB and valid UTF-8. Known fields irrelevant to ping/subscribe are accepted by the current parser; use the minimal documented frames. RPC IDs and error messages have UTF-8 byte limits enforced at runtime.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relayhub.dungxbuif.com/docs/schemas/client-frame.schema.json",
  "title": "RelayHub client frame"
}
