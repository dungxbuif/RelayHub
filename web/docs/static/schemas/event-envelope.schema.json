{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "source_app_id": {
      "type": "string",
      "minLength": 1
    },
    "target_app_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "data": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "queue": {
      "type": "object",
      "properties": {
        "available_at": {"type": "string", "format": "date-time"},
        "ordering_key": {"type": "string", "maxLength": 128},
        "priority": {"type": "integer", "minimum": -10, "maximum": 10},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "source_app_id",
    "target_app_ids",
    "data",
    "created_at"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relayhub.dungxbuif.com/docs/schemas/event-envelope.schema.json",
  "title": "RelayHub event envelope"
}
