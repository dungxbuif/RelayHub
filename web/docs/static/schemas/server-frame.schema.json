{
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "ready"
        },
        "app_id": {
          "type": "string",
          "minLength": 1
        },
        "connection_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "app_id",
        "connection_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "subscribed"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "events",
              "jobs",
              "functions"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "type",
        "topics"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "event"
        },
        "event": {
          "$ref": "https://relayhub.dungxbuif.com/docs/schemas/event-envelope.schema.json"
        }
      },
      "required": [
        "type",
        "event"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "job.updated"
        },
        "job": {
          "$ref": "#/$defs/job"
        }
      },
      "required": [
        "type",
        "job"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "channel.message"
        },
        "channel": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.:-]{0,95}$"
        },
        "publisher_app_id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "type",
        "channel",
        "publisher_app_id",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "pong"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "rpc.invoke"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "function": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
        },
        "input": {
          "type": "object"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "invocation_id",
        "function",
        "input",
        "deadline"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "job": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "source_app_id": {
          "type": "string",
          "minLength": 1
        },
        "target_app_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "leased",
            "delivered",
            "acked",
            "dead_letter"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "callback": {
          "type": "boolean"
        },
        "callback_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "callback_generation": {
          "type": "integer",
          "minimum": 0
        },
        "retry_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_reason": {
          "type": "string"
        },
        "lease_until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "event_id",
        "source_app_id",
        "target_app_id",
        "status",
        "attempts",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    }
  },
  "description": "Server JSON text messages. channel.message frames are online-only realtime fan-out. Complete RPC envelopes must fit 64 KiB. Outbound event notifications follow the accepted publication size (1 MiB HTTP body limit) plus envelope overhead; they may exceed 64 KiB.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relayhub.dungxbuif.com/docs/schemas/server-frame.schema.json",
  "title": "RelayHub server frame"
}
