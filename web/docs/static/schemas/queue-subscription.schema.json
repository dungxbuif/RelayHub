{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relayhub.dungxbuif.com/docs/schemas/queue-subscription.schema.json",
  "title": "RelayHub Queue workers subscription",
  "type": "object",
  "required": ["id", "app_id", "name", "enabled", "max_attempts", "default_visibility_seconds", "max_visibility_seconds", "max_total_lease_seconds", "retention_seconds", "max_in_flight", "max_batch_size", "retry_delay_seconds", "ordering_mode", "deduplication_seconds", "policy_version", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^sub_"},
    "app_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
    "enabled": {"type": "boolean"},
    "paused_at": {"type": "string", "format": "date-time"},
    "draining_at": {"type": "string", "format": "date-time"},
    "drain_deadline_at": {"type": "string", "format": "date-time"},
    "drained_at": {"type": "string", "format": "date-time"},
    "event_types": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 100},
    "default_visibility_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
    "max_visibility_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "max_total_lease_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "retention_seconds": {"type": "integer", "minimum": 60, "maximum": 2592000},
    "max_in_flight": {"type": "integer", "minimum": 1, "maximum": 10000},
    "max_batch_size": {"type": "integer", "minimum": 1, "maximum": 100},
    "retry_delay_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
    "ordering_mode": {"enum": ["none", "key"]},
    "deduplication_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
    "max_dispatch_rate": {"type": "integer", "minimum": 1, "maximum": 100000},
    "success_callback_url": {"type": "string", "format": "uri"},
    "failure_callback_url": {"type": "string", "format": "uri"},
    "result_callback_metadata": {"type": "object"},
    "policy_version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
