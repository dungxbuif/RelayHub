{
  "openapi": "3.1.0",
  "info": {
    "title": "RelayHub Runtime API (in-memory baseline)",
    "version": "0.1.0",
    "description": "Current working surface is an in-memory baseline implementation: enqueue jobs, claim attempts, and realtime stubs. No persistence, NATS, or Centrifugo engine is embedded yet."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "Alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string"},
                    "provider": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs": {
      "post": {
        "summary": "Enqueue a job",
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobId": {"type": "string"},
                    "status": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      },
      "get": {"responses": {"501": {"description": "List not implemented"}}}
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "summary": "Get job by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workers/claim": {
      "post": {
        "summary": "Worker claim one job",
        "responses": {
          "200": {"description": "Claimed"},
          "204": {"description": "No job available"}
        }
      }
    },
    "/api/v1/attempts/{id}/heartbeat": {
      "post": {
        "summary": "Extend attempt lease",
        "responses": {
          "200": {"description": "Lease extended"},
          "409": {"description": "Lease lost"}
        }
      }
    },
    "/api/v1/attempts/{id}/progress": {
      "post": {
        "summary": "Post attempt progress",
        "responses": {"202": {"description": "Progress accepted"}}
      }
    },
    "/api/v1/attempts/{id}/complete": {
      "post": {
        "summary": "Complete attempt",
        "responses": {"200": {"description": "Attempt completed"}}
      }
    },
    "/api/v1/attempts/{id}/fail": {
      "post": {
        "summary": "Fail attempt",
        "responses": {"200": {"description": "Attempt marked failed"}}
      }
    },
    "/api/v1/realtime/sessions": {
      "post": {
        "summary": "Create realtime session token (stub)",
        "responses": {"201": {"description": "Session token"}}
      }
    },
    "/api/v1/realtime/grants": {
      "post": {
        "summary": "Create realtime grant token (stub)",
        "responses": {"201": {"description": "Grant token and wireChannel"}}
      }
    },
    "/api/v1/realtime/publish": {
      "post": {
        "summary": "Publish realtime event (stub)",
        "responses": {"202": {"description": "Accepted"}}
      }
    }
  },
  "components": {
    "schemas": {
      "Job": {
        "type": "object",
        "properties": {
          "jobId": {"type": "string"},
          "queue": {"type": "string"},
          "handlerVersion": {"type": "string"},
          "status": {"type": "string"},
          "attemptCount": {"type": "integer"},
          "createdAt": {"type": "string"},
          "updatedAt": {"type": "string"}
        }
      }
    }
  }
}
