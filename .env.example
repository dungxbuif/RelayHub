# Copy to .env; never commit .env. Required credentials are intentionally empty.
# Generate each independently with: openssl rand -hex 32
RELAYHUB_ADMIN_TOKEN=
RELAYHUB_SIGNING_SECRET=
RELAYHUB_REDIS_PASSWORD=
# Compose publishes only API. Change to 127.0.0.1:8080 for a host-local proxy.
RELAYHUB_PORT=8080
RELAYHUB_STOP_GRACE_PERIOD=20s
# Binary listener settings; root Compose fixes these to preserve health/routing.
RELAYHUB_HTTP_ADDR=:8080
RELAYHUB_WORKER_HTTP_ADDR=:9090
# Separate password is URL-encoded and overrides any password already in this URL.
RELAYHUB_REDIS_URL=redis://relayhub-redis:6379/0
RELAYHUB_REDIS_KEY_PREFIX=relayhub
# Empty rejects browser Origins; native/server WebSocket clients still work.
RELAYHUB_ALLOWED_ORIGINS=
RELAYHUB_EVENT_RETENTION=168h
RELAYHUB_JOB_RETENTION=168h
RELAYHUB_IDEMPOTENCY_RETENTION=24h
RELAYHUB_SIGNING_SKEW=5m
RELAYHUB_SHUTDOWN_TIMEOUT=10s
RELAYHUB_CALLBACK_TIMEOUT=10s
RELAYHUB_WORKER_RECLAIM_IDLE=30s
RELAYHUB_WORKER_CONCURRENCY=8
RELAYHUB_ALLOW_INSECURE_CALLBACKS=false
# Acceptance control only: 1 keeps its isolated project; default cleans all of it.
RELAYHUB_E2E_KEEP=0
