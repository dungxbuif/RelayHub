# Copy to .env; never commit .env. Required credentials are intentionally empty.
# Generate each independently with: openssl rand -hex 32
RELAYHUB_ADMIN_TOKEN=
RELAYHUB_SIGNING_SECRET=
RELAYHUB_POSTGRES_PASSWORD=
RELAYHUB_NATS_USERNAME=
RELAYHUB_NATS_PASSWORD=
# Compose publishes only API. Change to 127.0.0.1:8080 for a host-local proxy.
RELAYHUB_PORT=8080
RELAYHUB_STOP_GRACE_PERIOD=20s
# Binary listener settings; root Compose fixes these to preserve health/routing.
RELAYHUB_HTTP_ADDR=:8080
RELAYHUB_WORKER_HTTP_ADDR=:9090
# PostgreSQL is the v1 authoritative control and event state store.
RELAYHUB_POSTGRES_URL=postgres://relayhub:${RELAYHUB_POSTGRES_PASSWORD}@relayhub-postgres:5432/relayhub?sslmode=disable
# Generate with: openssl rand -base64 32
RELAYHUB_SECRET_ENCRYPTION_KEY=
# NATS is private to the RelayHub Compose network; keep credentials out of URLs.
RELAYHUB_NATS_URL=nats://relayhub-nats:4222
RELAYHUB_NATS_CONNECT_TIMEOUT=2s
RELAYHUB_NATS_RECONNECT_WAIT=2s
RELAYHUB_NATS_MAX_RECONNECTS=-1
RELAYHUB_NATS_DRAIN_TIMEOUT=10s
RELAYHUB_NATS_STREAM_MAX_AGE=168h
RELAYHUB_NATS_DUPLICATE_WINDOW=24h
RELAYHUB_NATS_REPLICAS=1
# Redis is shared ephemeral state. Compose wiring is added with the horizontal-scale runtime.
RELAYHUB_REDIS_MODE=standalone
RELAYHUB_REDIS_ADDRS=relayhub-redis:6379
RELAYHUB_REDIS_USERNAME=
RELAYHUB_REDIS_PASSWORD=
RELAYHUB_REDIS_SENTINEL_MASTER=
RELAYHUB_REDIS_DB=0
RELAYHUB_REDIS_TLS=false
RELAYHUB_REDIS_KEY_PREFIX=rh
RELAYHUB_REDIS_CONNECT_TIMEOUT=2s
RELAYHUB_REDIS_READ_TIMEOUT=1s
RELAYHUB_REDIS_WRITE_TIMEOUT=1s
RELAYHUB_REDIS_POOL_SIZE=32
# Optional S3-compatible file messaging. Leave all values empty to disable it.
RELAYHUB_OBJECT_STORAGE_ENDPOINT=
RELAYHUB_OBJECT_STORAGE_BUCKET=
RELAYHUB_OBJECT_STORAGE_REGION=
RELAYHUB_OBJECT_STORAGE_ACCESS_KEY=
RELAYHUB_OBJECT_STORAGE_SECRET_KEY=
# Optional stable replica name; leave empty to generate api_<uuid>/worker_<uuid>.
RELAYHUB_INSTANCE_ID=
# Empty rejects browser Origins; native/server WebSocket clients still work.
RELAYHUB_ALLOWED_ORIGINS=
RELAYHUB_EVENT_RETENTION=168h
RELAYHUB_JOB_RETENTION=168h
RELAYHUB_IDEMPOTENCY_RETENTION=24h
RELAYHUB_SIGNING_SKEW=5m
RELAYHUB_SHUTDOWN_TIMEOUT=10s
RELAYHUB_CALLBACK_TIMEOUT=10s
RELAYHUB_WORKER_RECLAIM_IDLE=30s
RELAYHUB_WORKER_CONCURRENCY=8
RELAYHUB_ALLOW_INSECURE_CALLBACKS=false
# Test-tool settings; export explicitly for host test commands (not app settings).
RELAYHUB_TEST_POSTGRES_URL=
